# Environment Variables Example
# Copy this file to .env and update with your actual values

# Django Settings
DEBUG=True
SECRET_KEY=your-super-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/telemed
POSTGRES_DB=telemed
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=30

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# API Configuration
API_VERSION=v1
API_RATE_LIMIT=100/hour
API_PAGINATION_SIZE=20

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
DEFAULT_FROM_EMAIL=noreply@telemed.com

# AWS Configuration (if using S3 for file storage)
USE_S3=False
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=telemed-storage
AWS_S3_REGION_NAME=us-east-1

# Jitsi Configuration
JITSI_SERVER_URL=https://meet.jitsi
JITSI_APP_ID=your-jitsi-app-id
JITSI_APP_SECRET=your-jitsi-app-secret

# Frontend Configuration
VITE_APP_NAME=Telemed
VITE_APP_VERSION=1.0.0
VITE_APP_API_URL=http://localhost:8000/api/v1
VITE_APP_API_TIMEOUT=30000
VITE_APP_JITSI_URL=https://meet.jitsi
VITE_APP_THEME=light

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_BROWSER_XSS_FILTER=True
SECURE_CONTENT_SECURITY_POLICY=True

# Feature Flags
FEATURE_VIDEO_CONSULTATION=True
FEATURE_PRESCRIPTION_MANAGEMENT=True
FEATURE_APPOINTMENT_SCHEDULING=True
FEATURE_PATIENT_PORTAL=True
FEATURE_DOCTOR_DASHBOARD=True

# Analytics
ANALYTICS_ENABLED=False
ANALYTICS_KEY=your-analytics-key

# Monitoring
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Timezone
TIMEZONE=UTC

# Pagination
PAGE_SIZE=20
MAX_PAGE_SIZE=100

# File Upload
MAX_UPLOAD_SIZE=5242880
ALLOWED_EXTENSIONS=pdf,doc,docx,jpg,jpeg,png,txt

# Testing
TEST_DATABASE_NAME=telemed_test
PYTEST_ARGS=-v --cov=apps

# Development
DEVELOPMENT_MODE=True
MOCK_EMAIL=True
MOCK_PAYMENTS=True
